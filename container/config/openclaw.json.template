{
  "$schema": "https://openclaw.ai/schemas/openclaw.json",
  "diagnostics": { "enabled": false },
  "tools": {
    "profile": "minimal",
    "web": {
      "search":   { "enabled": false },
      "fetch":    { "enabled": false },
      "x_search": { "enabled": false }
    },
    "links":        { "enabled": false },
    "experimental": { "planTool": false }
  },
  "mcp": {
    "servers": {
      "web_search": {
        "command": "python3",
        "args": ["-u", "__MCP_WEB_SEARCH_PATH__"]
      },
      "fetch_book_excerpt": {
        "command": "python3",
        "args": ["-u", "__MCP_FETCH_BOOK_EXCERPT_PATH__"]
      },
      "download_full_text": {
        "command": "python3",
        "args": ["-u", "__MCP_DOWNLOAD_FULL_TEXT_PATH__"]
      },
      "pdf_to_text": {
        "command": "python3",
        "args": ["-u", "__MCP_PDF_TO_TEXT_PATH__"]
      },
      "remove_watermark": {
        "command": "python3",
        "args": ["-u", "__MCP_REMOVE_WATERMARK_PATH__"]
      },
      "fetch_page": {
        "command": "python3",
        "args": ["-u", "__MCP_FETCH_PAGE_PATH__"]
      },
      "fetch_by_identifier": {
        "command": "python3",
        "args": ["-u", "__MCP_FETCH_BY_IDENTIFIER_PATH__"]
      },
      "summarize_source": {
        "command": "python3",
        "args": ["-u", "__MCP_SUMMARIZE_SOURCE_PATH__"]
      },
      "compacted_get_book_text": {
        "command": "python3",
        "args": ["-u", "__MCP_COMPACTED_GET_BOOK_TEXT_PATH__"]
      }
    }
  },
  "models": {
    "providers": {
      "openrouter": {
        "baseUrl": "https://openrouter.ai/api/v1",
        "api": "openai-completions",
        "auth": "api-key",
        "apiKey": {
          "source": "env",
          "provider": "default",
          "id": "OPENROUTER_API_KEY"
        },
        "models": [
          {
            "id": "__MODEL_SLUG__",
            "name": "__MODEL_SLUG__",
            "api": "openai-completions"
          }
        ]
      }
    }
  },
  "agents": {
    "defaults": {
      "skills": ["web_search"]
    },
    "list": [
      {
        "id": "trajrec",
        "default": true,
        "model": "openrouter/__MODEL_SLUG__",
        "skills": [
          "web_search",
          "fetch_book_excerpt",
          "download_full_text",
          "pdf_to_text",
          "remove_watermark",
          "fetch_page",
          "fetch_by_identifier",
          "summarize_source",
          "compacted_get_book_text"
        ],
        "tools": {
          "profile": "minimal",
          "alsoAllow": [
            "web_search__web_search",
            "fetch_book_excerpt__fetch_book_excerpt",
            "download_full_text__download_full_text",
            "pdf_to_text__pdf_to_text",
            "remove_watermark__remove_watermark",
            "fetch_page__fetch_page",
            "fetch_by_identifier__fetch_by_identifier",
            "summarize_source__summarize_source",
            "compacted_get_book_text__compacted_get_book_text"
          ]
        },
        "systemPromptOverride": "__SYSTEM_PROMPT__"
      }
    ]
  }
}
